{
  "POST /projects": {
    "summary": "Create a project",
    "operationId": "createProject",
    "requestBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "name"
      ]
    }
  },
  "POST /projects/{projectId}/chat/messages": {
    "summary": "Send a chat message (start a design run)",
    "operationId": "sendProjectChatMessage",
    "requestBody": {
      "type": "object",
      "properties": {
        "message": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "text"
          ]
        },
        "imageUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": []
        },
        "target": {
          "type": "object",
          "properties": {
            "screenId": {
              "type": "string",
              "minLength": 1,
              "description": "The screen to edit, identified by its screenId as returned by the components endpoints and by run results. It is not the component id."
            }
          },
          "required": [
            "screenId"
          ]
        },
        "models": {
          "type": "object",
          "properties": {
            "mainAgent": {
              "type": "string"
            },
            "mainAgentSetup": {
              "type": "string"
            }
          },
          "description": "Experiment-only per-phase model overrides. Honored only when the server runs with ENABLE_MODEL_OVERRIDE=true; inert in production."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "message"
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string"
            },
            "status": {
              "enum": [
                "queued",
                "running",
                "completed",
                "failed"
              ],
              "type": "string"
            },
            "statusUrl": {
              "type": "string"
            },
            "result": {
              "type": "object",
              "properties": {
                "assistantText": {
                  "type": "string"
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "screen_created"
                          },
                          "screenId": {
                            "type": "string"
                          },
                          "screenName": {
                            "type": "string"
                          },
                          "componentId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "screenId",
                          "screenName",
                          "componentId"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "screen_updated"
                          },
                          "screenId": {
                            "type": "string"
                          },
                          "componentId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "screenId",
                          "componentId"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "theme_updated"
                          }
                        },
                        "required": [
                          "type"
                        ]
                      }
                    ]
                  }
                }
              },
              "required": [
                "assistantText",
                "operations"
              ],
              "description": "Best-effort apply semantics: failed runs can include operations already applied before failure."
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "Where the caller's user can resolve this error (e.g. top up credits). Relay it to the user."
                }
              },
              "required": [
                "code",
                "message"
              ]
            }
          },
          "required": [
            "runId",
            "status",
            "statusUrl"
          ]
        }
      },
      "required": [
        "data"
      ]
    }
  },
  "GET /projects/{projectId}/chat/runs/{runId}": {
    "summary": "Get a chat run",
    "operationId": "getProjectChatRun",
    "response": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string"
            },
            "status": {
              "enum": [
                "queued",
                "running",
                "completed",
                "failed"
              ],
              "type": "string"
            },
            "statusUrl": {
              "type": "string"
            },
            "result": {
              "type": "object",
              "properties": {
                "assistantText": {
                  "type": "string"
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "screen_created"
                          },
                          "screenId": {
                            "type": "string"
                          },
                          "screenName": {
                            "type": "string"
                          },
                          "componentId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "screenId",
                          "screenName",
                          "componentId"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "screen_updated"
                          },
                          "screenId": {
                            "type": "string"
                          },
                          "componentId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "screenId",
                          "componentId"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "theme_updated"
                          }
                        },
                        "required": [
                          "type"
                        ]
                      }
                    ]
                  }
                }
              },
              "required": [
                "assistantText",
                "operations"
              ],
              "description": "Best-effort apply semantics: failed runs can include operations already applied before failure."
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "Where the caller's user can resolve this error (e.g. top up credits). Relay it to the user."
                }
              },
              "required": [
                "code",
                "message"
              ]
            }
          },
          "required": [
            "runId",
            "status",
            "statusUrl"
          ]
        }
      },
      "required": [
        "data"
      ]
    }
  },
  "POST /screenshots": {
    "summary": "Render a component screenshot",
    "operationId": "takeScreenshot",
    "requestBody": {
      "type": "object",
      "properties": {
        "componentIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "componentVersionOverrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "themeVersionOverrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "format": {
          "enum": [
            "png",
            "webp"
          ],
          "type": "string",
          "default": "png"
        },
        "scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 2
        },
        "gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 40
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 40
        },
        "paddingX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paddingY": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paddingTop": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paddingRight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paddingBottom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paddingLeft": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "background": {
          "type": "string",
          "default": "transparent"
        },
        "showDots": {
          "type": "boolean",
          "default": false
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 48
        },
        "fullHeight": {
          "type": "boolean",
          "default": false,
          "description": "Expand each frame to the full height of its content before capturing, so scrollable screens are rendered fully extended rather than cut off at the bottom of the frame. Frames are capped at 4x the default frame height."
        }
      },
      "required": [
        "componentIds",
        "projectId"
      ]
    }
  },
  "POST /device/start": {
    "summary": "Start device authorization",
    "operationId": "deviceStart",
    "requestBody": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "POST /device/poll": {
    "summary": "Poll device authorization",
    "operationId": "devicePoll",
    "requestBody": {
      "type": "object",
      "properties": {
        "deviceCode": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "deviceCode"
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "pending"
                }
              },
              "required": [
                "status"
              ]
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "approved"
                },
                "key": {
                  "type": "string"
                },
                "keyId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "key",
                "keyId",
                "name"
              ]
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "expired"
                }
              },
              "required": [
                "status"
              ]
            }
          ]
        }
      },
      "required": [
        "data"
      ]
    }
  },
  "GET /projects/{projectId}/components": {
    "summary": "List a project's components",
    "operationId": "listComponents",
    "response": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "screenId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The id of the screen this component renders on the canvas. It is the value target.screenId takes when you edit this screen with a chat message, and the same screenId run results report. Null when the component is not placed on a canvas."
              },
              "name": {
                "type": "string"
              },
              "activeVersion": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "version": {
                      "type": "number"
                    },
                    "code": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "version",
                    "code",
                    "createdAt"
                  ]
                }
              },
              "createdAt": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "screenId",
              "name",
              "activeVersion",
              "versions",
              "createdAt",
              "updatedAt"
            ]
          }
        },
        "pagination": {
          "type": "object",
          "properties": {
            "total": {
              "type": "number"
            },
            "limit": {
              "type": "number"
            },
            "offset": {
              "type": "number"
            }
          },
          "required": [
            "total",
            "limit",
            "offset"
          ]
        }
      },
      "required": [
        "data",
        "pagination"
      ]
    }
  },
  "GET /projects/{projectId}/components/{componentId}": {
    "summary": "Get a component",
    "operationId": "findComponent",
    "response": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "screenId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The id of the screen this component renders on the canvas. It is the value target.screenId takes when you edit this screen with a chat message, and the same screenId run results report. Null when the component is not placed on a canvas."
            },
            "name": {
              "type": "string"
            },
            "activeVersion": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "versions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "number"
                  },
                  "code": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "version",
                  "code",
                  "createdAt"
                ]
              }
            },
            "createdAt": {
              "type": "string"
            },
            "updatedAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "screenId",
            "name",
            "activeVersion",
            "versions",
            "createdAt",
            "updatedAt"
          ]
        }
      },
      "required": [
        "data"
      ]
    }
  }
}